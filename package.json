{
  "name": "vue-style-runtime",
  "version": "1.0.2",
  "author": "wanggang <76527413@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbaxp/vue-style-runtime.git"
  },
  "homepage": "https://github.com/nbaxp/vue-style-runtime#readme",
  "bugs": {
    "url": "https://github.com/nbaxp/vue-style-runtime/issues"
  },
  "description": "A lightweight browser-side Vue 3 runtime for component style injection and scoped CSS transformation.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./index.min.js": "./dist/index.min.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.min.js"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "mixin",
    "style",
    "style-injection",
    "scoped",
    "no-bundler"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.js --mode unminified && vite build --config vite.lib.config.js --mode min",
    "preview": "vite preview",
    "prepack": "npm run build:lib",
    "test": "node --test \"tests/**/*.test.js\"",
    "bench": "node benchmarks/css.bench.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "vite": "^8.3.8",
    "vue": "^3.5.44"
  }
}
